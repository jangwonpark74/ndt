{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ndt:equipment-inventory:v1",
  "title": "NDT equipment inventory import",
  "description": "Operator-supplied equipment and vendor pattern evidence. IDs must be unique within each collection. The server validates references, same-site links, regional site IDs, normalized pattern cuts, a total of 20000 records and a 2 MB UTF-8 source limit. Source claims are not independent deployment verification.",
  "type": "object",
  "required": [
    "schemaVersion",
    "sources",
    "sites",
    "sectors",
    "radios",
    "antennas",
    "cells",
    "ports",
    "links",
    "patterns"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "uri",
          "observedAt",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "uri": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^(https?:|urn:)"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "enum": [
              "operator",
              "vendor",
              "survey",
              "assumption"
            ]
          }
        }
      }
    },
    "sites": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "sourceRecordId",
          "inventorySiteId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceRecordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "manufacturer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "inventorySiteId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "sectors": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "sourceRecordId",
          "siteId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceRecordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "manufacturer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "siteId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "azimuthDeg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 359.999
          }
        }
      }
    },
    "radios": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "sourceRecordId",
          "siteId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceRecordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "manufacturer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "siteId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "powerDbm": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -30,
            "maximum": 80
          }
        }
      }
    },
    "antennas": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "sourceRecordId",
          "siteId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceRecordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "manufacturer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "siteId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "patternId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "gainDbi": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 50
          },
          "tiltDeg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -20,
            "maximum": 90
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "sourceRecordId",
          "sectorId",
          "rat"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceRecordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "manufacturer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "sectorId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "radioId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rat": {
            "enum": [
              "LTE",
              "NR"
            ]
          },
          "cellIdentity": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "frequencyMHz": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 500,
            "maximum": 100000
          },
          "bandwidthMHz": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0.1,
            "maximum": 400
          }
        }
      }
    },
    "ports": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "sourceRecordId",
          "equipmentId",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceRecordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "manufacturer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "equipmentId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "role": {
            "enum": [
              "radio",
              "antenna"
            ]
          }
        }
      }
    },
    "links": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "sourceRecordId",
          "cellId",
          "radioPortId",
          "antennaPortId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceRecordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "manufacturer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "cellId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "radioPortId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "antennaPortId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          }
        }
      }
    },
    "patterns": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceId",
          "sourceRecordId",
          "horizontal",
          "vertical"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "sourceRecordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "manufacturer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "horizontal": {
            "type": "array",
            "minItems": 3,
            "maxItems": 721,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 80
                }
              ],
              "items": false
            },
            "$comment": "Strictly increasing angles, full extent, normalized 0 dB peak; horizontal endpoint attenuations must match. The server enforces these constraints."
          },
          "vertical": {
            "type": "array",
            "minItems": 3,
            "maxItems": 721,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 80
                }
              ],
              "items": false
            },
            "$comment": "Strictly increasing angles, full extent, normalized 0 dB peak; horizontal endpoint attenuations must match. The server enforces these constraints."
          }
        }
      }
    }
  }
}
