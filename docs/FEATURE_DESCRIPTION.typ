    ..entries.map(row => (
      text(weight: "bold", row.at(0)),
      [*#(row.at(1))* #linebreak() #text(size: 8pt, fill: rgb("517465"))[#(row.at(3)) · #(row.at(4))]],
      [#(row.at(5)) #linebreak() #(row.at(6))],
      text(row.at(7)),
    )).flatten(),
  )
}
